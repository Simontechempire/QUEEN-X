# ═════════════════════════════════════════════════════
#                 Qᴜᴇᴇɴ X CONFIGURATION
# ═════════════════════════════════════════════════════

# ─────────────── BOT ───────────────

BOT_NAME=Qᴜᴇᴇɴ X
PREFIX=.
BOT_MODE=public
LANGUAGE=en
TIMEZONE=Africa/Lagos

# ─────────────── OWNER ───────────────

OWNER_NAME=Simon Tech
OWNER_NUMBER=234XXXXXXXXXX
OWNER_EMAIL=

# ─────────────── SERVER ───────────────

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ─────────────── DASHBOARD ───────────────

DASHBOARD_URL=https://your-render-service.onrender.com
DASHBOARD_NAME=Qᴜᴇᴇɴ X Dashboard
ALLOW_REGISTRATION=true

# ─────────────── AUTHENTICATION ───────────────

SESSION_SECRET=change-this-to-a-long-random-secret
SESSION_DURATION=86400000
COOKIE_SECURE=true

# ─────────────── DATABASE ───────────────

DATABASE_FILE=./data/users.json
SETTINGS_FILE=./data/settings.json

# ─────────────── WHATSAPP ───────────────

SESSION_DIR=./sessions
PAIRING_ENABLED=true
QR_ENABLED=true
AUTO_RECONNECT=true
RECONNECT_DELAY=5000

# ─────────────── AUTOMATION ───────────────

AUTO_READ=false
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_VIEW_STATUS=false
AUTO_REACT=false
AUTO_REPLY=false
AUTO_WELCOME=false
AUTO_GOODBYE=false

# ─────────────── GROUP SECURITY ───────────────

ANTI_LINK=false
ANTI_SPAM=false
ANTI_DELETE=false
ANTI_CALL=false
ANTI_BOT=false
ANTI_FLOOD=false

# ─────────────── COMMAND SETTINGS ───────────────

COMMANDS_ENABLED=true
OWNER_ONLY=false
GROUP_ONLY=false
COOLDOWN_ENABLED=true
COMMAND_COOLDOWN=2

# ─────────────── AI ───────────────

AI_ENABLED=true
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─────────────── MEDIA ───────────────

MEDIA_ENABLED=true
MAX_FILE_SIZE=100
DOWNLOAD_TIMEOUT=120000

# ─────────────── LOGGING ───────────────

LOG_LEVEL=info
LOG_COMMANDS=true
LOG_CONNECTIONS=true
LOG_ERRORS=true

# ─────────────── PERFORMANCE ───────────────

MAX_CONNECTIONS=10
REQUEST_TIMEOUT=30000
RATE_LIMIT=100

# ─────────────── DEVELOPMENT ───────────────

DEBUG=false
DEV_MODE=false
